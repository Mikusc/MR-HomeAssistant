# Normalize line endings across Windows and macOS clones.
* text=auto

# Keep common Unity/text assets stable and merge-friendly.
*.cs text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.compute text eol=lf
*.hlsl text eol=lf
*.json text eol=lf
*.md text eol=lf
*.meta text eol=lf
*.txt text eol=lf
*.unity text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.asset text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.xml text eol=lf

# Preserve binary assets as binary.
*.aab binary
*.apk binary
*.dll binary
*.fbx binary
*.gif binary
*.jar binary
*.jpg binary
*.jpeg binary
*.mp3 binary
*.mp4 binary
*.ogg binary
*.pdf binary
*.png binary
*.psd binary
*.tga binary
*.tif binary
*.tiff binary
*.ttf binary
*.wav binary
*.woff binary
*.woff2 binary
*.zip binary
